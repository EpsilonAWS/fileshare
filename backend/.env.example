# Copy to .env (never commit .env).
# Lines starting with # are off — uncomment and fill in only what you need.
# (Don't leave a variable set to an empty value: an empty DATABASE_URL or SECRET_KEY breaks startup.)

# Local dev: storage links go through the Vite dev server, so the browser only talks to one address.
BASE_URL=http://localhost:5173

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Production only ────────────────────────────────────────────────────────────
# Supabase: use the connection pooler URL (port 6543). Without it, SQLite (backend/ephemera.db) is used.
# DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Cloudflare R2. Without these, files are stored on disk in backend/storage/.
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=

# Long random strings. SECRET_KEY is required on Vercel.
# SECRET_KEY=
# CRON_SECRET=
